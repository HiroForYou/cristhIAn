---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Footer from '@/components/Footer.astro';
import { slugify } from '@/utils/slugify.js';
import { readingTime } from '@/utils/readingTime.js';
import { getPosts, entrySlug } from '@/utils/content.js';
import { basePath, dateLocale, getLang, localeParams, useTranslations } from '@/i18n';

export const getStaticPaths = localeParams;

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const base = basePath(lang);
const posts = await getPosts(lang);

const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags))).sort((a, b) =>
  a.localeCompare(b)
);

const VISIBLE_TAG_LIMIT = 8;
const visibleTags = allTags.slice(0, VISIBLE_TAG_LIMIT);
const overflowTags = allTags.slice(VISIBLE_TAG_LIMIT);

const dateFormatter = new Intl.DateTimeFormat(dateLocale[lang], {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const [featured] = posts;

// Without an explicit date Google guesses one from the page text and tends
// to pick the oldest post in the list, making the blog look abandoned.
// The Blog node gives it the real last update and the list of posts.
const SITE = 'https://www.cristhianwiki.com';
const lastUpdated = new Date(
  Math.max(...posts.map(post => (post.data.updated ?? post.data.date).valueOf()))
);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}${base}/blog/#blog`,
  name: 'Cristhian Wiki — Blog',
  description: t('blog.description'),
  url: `${SITE}${base}/blog/`,
  inLanguage: lang,
  dateModified: lastUpdated.toISOString(),
  author: { '@id': `${SITE}/#person` },
  publisher: { '@id': `${SITE}/#person` },
  isPartOf: { '@id': `${SITE}/#website` },
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    '@id': `${SITE}${base}/blog/${entrySlug(post)}/#article`,
    headline: post.data.title,
    url: `${SITE}${base}/blog/${entrySlug(post)}/`,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
  })),
};
---

<Layout title={t('blog.title')} description={t('blog.description')}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Navbar client:load pathname={Astro.url.pathname} />
  <main>
    <section class="container blog-index">
      <header class="blog-hero">
        <p class="eyebrow">{t('blog.eyebrow')}</p>
        <h1 class="blog-hero__title" set:html={t('blog.heading')} />
        <p class="blog-hero__intro">{t('blog.intro')}</p>
        <a class="blog-hero__rss" href={`${base}/rss.xml`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
          {t('blog.rss')}
        </a>
      </header>

      {
        featured && (
          <a class="featured" href={`${base}/blog/${entrySlug(featured)}/`} id="blog-featured">
            {featured.data.cover && (
              <div class="featured__media">
                <Image
                  src={featured.data.cover}
                  alt=""
                  widths={[480, 800, 1100]}
                  sizes="(max-width: 860px) 100vw, 560px"
                  loading="eager"
                />
              </div>
            )}
            <div class="featured__body">
              <span class="featured__badge">{t('blog.latest')}</span>
              <h2 class="featured__title">{featured.data.title}</h2>
              {featured.data.excerpt && <p class="featured__excerpt">{featured.data.excerpt}</p>}
              <p class="post-meta">
                {dateFormatter.format(featured.data.date)} · {readingTime(featured.body)} {t('blog.minRead')}
              </p>
              <span class="featured__cta">
                {t('blog.readPost')}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        )
      }

      <div class="blog-toolbar">
        <div class="blog-controls__tags" id="blog-tag-filter">
          <button type="button" class="chip is-active" data-tag="all">{t('blog.all')}</button>
          {
            visibleTags.map(tag => (
              <button type="button" class="chip" data-tag={slugify(tag)}>
                {tag}
              </button>
            ))
          }
          {
            overflowTags.map(tag => (
              <button type="button" class="chip" data-tag={slugify(tag)} data-overflow-tag hidden>
                {tag}
              </button>
            ))
          }
          {
            overflowTags.length > 0 && (
              <button type="button" class="chip blog-controls__more" id="blog-tags-more" data-less={t('blog.showLess')}>
                +{overflowTags.length} {t('blog.more')}
              </button>
            )
          }
        </div>

        <label class="blog-search" for="blog-search-input">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input type="search" id="blog-search-input" placeholder={t('blog.search')} autocomplete="off" />
        </label>
      </div>

      <ul class="post-list" id="blog-post-list">
        {
          posts.map((post, i) => (
            <li
              class="post-row"
              data-featured={i === 0 ? '' : undefined}
              data-tags={post.data.tags.map(slugify).join(',')}
              data-search={`${post.data.title} ${post.data.excerpt ?? ''} ${post.data.tags.join(' ')}`.toLowerCase()}
            >
              <time class="post-row__date" datetime={post.data.date.toISOString()}>
                {dateFormatter.format(post.data.date)}
              </time>
              <div class="post-row__body">
                <h2 class="post-row__title">
                  <a href={`${base}/blog/${entrySlug(post)}/`}>{post.data.title}</a>
                </h2>
                {post.data.excerpt && <p class="post-row__excerpt">{post.data.excerpt}</p>}
                <div class="post-row__foot">
                  <span class="post-meta">{readingTime(post.body)} {t('blog.minRead')}</span>
                  {post.data.tags.map(tag => (
                    <a class="tag" href={`${base}/blog?tag=${slugify(tag)}`}>
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
              {post.data.cover && (
                <div class="post-row__thumb">
                  <Image src={post.data.cover} alt="" width={400} />
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <p class="blog-index__empty" id="blog-empty" hidden>
        {t('blog.empty')}
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    padding-top: 64px;
  }

  /* ---------- Hero ---------- */

  .blog-hero {
    max-width: 760px;
    margin-bottom: 56px;
  }

  .blog-hero__title {
    font-size: clamp(2.6rem, 6.5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
  }

  .blog-hero__intro {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 58ch;
    margin: 0;
  }

  .blog-hero__rss {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .blog-hero__rss:hover {
    color: var(--color-primary-light);
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ---------- Featured ---------- */

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .featured[hidden] {
    display: none;
  }

  .featured:hover {
    color: var(--color-text);
    border-color: var(--color-primary-light);
    transform: translateY(-3px);
    box-shadow: 0 28px 60px -32px color-mix(in srgb, var(--color-primary) 55%, transparent);
  }

  .featured__media {
    position: relative;
    min-height: 300px;
    background: var(--color-bg);
    overflow: hidden;
  }

  .featured__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .featured:hover .featured__media :global(img) {
    transform: scale(1.03);
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 4vw, 44px);
  }

  .featured__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    color: #fff;
    background: var(--gradient-primary, var(--color-primary));
  }

  .featured__title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  .featured__excerpt {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .featured__cta {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-primary-light);
  }

  .featured__cta svg {
    transition: transform 0.2s ease;
  }

  .featured:hover .featured__cta svg {
    transform: translateX(4px);
  }

  /* ---------- Toolbar ---------- */

  .blog-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 72px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-controls__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-muted);
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .chip:hover {
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .chip.is-active {
    color: var(--color-text);
    background: var(--color-tag-bg);
    border-color: var(--color-tag-border);
  }

  .blog-controls__more {
    border-style: dashed;
    border-color: var(--color-border);
  }

  .blog-search {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(100%, 260px);
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    transition: border-color 0.15s ease;
  }

  .blog-search:focus-within {
    border-color: var(--color-primary-light);
  }

  .blog-search svg {
    flex: none;
  }

  .blog-search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
  }

  .blog-search input:focus {
    outline: none;
  }

  .blog-search input::placeholder {
    color: var(--color-text-muted);
  }

  /* ---------- List ---------- */

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The newest post already has the featured card; it only joins the list
     while a filter or search is active. */
  .post-list:not(.is-filtering) .post-row[data-featured] {
    display: none;
  }

  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 200px;
    gap: 32px;
    align-items: start;
    padding: 36px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-row[hidden] {
    display: none;
  }

  .post-row__date {
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .post-row__title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    text-wrap: balance;
  }

  .post-row__title a {
    color: var(--color-text);
    background-image: linear-gradient(var(--color-primary), var(--color-primary));
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The whole row is clickable through the title link. */
  .post-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-row:hover .post-row__title a {
    background-size: 100% 2px;
  }

  .post-row__excerpt {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 16px;
    max-width: 62ch;
  }

  .post-row__foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .post-row__foot .post-meta {
    margin-right: 6px;
  }

  .post-row__thumb {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .post-row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-row:hover .post-row__thumb :global(img) {
    transform: scale(1.04);
  }

  .blog-index__empty {
    color: var(--color-text-muted);
    padding: 48px 0;
    text-align: center;
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured__media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr) 140px;
      gap: 8px 24px;
    }

    .post-row__date {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .blog-index {
      padding-top: 32px;
    }

    .blog-toolbar {
      margin-top: 48px;
    }

    .blog-search {
      width: 100%;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 0;
    }

    .post-row__thumb {
      display: none;
    }
  }
</style>

<script>
  const list = document.getElementById('blog-post-list');
  const items = Array.from(list?.children ?? []) as HTMLElement[];
  const emptyMessage = document.getElementById('blog-empty');
  const featured = document.getElementById('blog-featured');

  const tagButtons = Array.from(document.querySelectorAll<HTMLElement>('#blog-tag-filter [data-tag]'));
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;

  let activeTag = 'all';
  let searchQuery = '';

  function applyFilter() {
    let visibleCount = 0;
    items.forEach(item => {
      const tags = (item.getAttribute('data-tags') ?? '').split(',');
      const matchesTag = activeTag === 'all' || tags.includes(activeTag);
      const matchesSearch = !searchQuery || (item.getAttribute('data-search') ?? '').includes(searchQuery);
      const visible = matchesTag && matchesSearch;
      item.hidden = !visible;
      if (visible) visibleCount++;
    });
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;

    // While filtering, the featured card steps aside and the newest post
    // shows up in the list like any other result.
    const filtering = activeTag !== 'all' || searchQuery !== '';
    list?.classList.toggle('is-filtering', filtering);
    if (featured) featured.hidden = filtering;
  }

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilter();
  });

  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      activeTag = button.getAttribute('data-tag') ?? 'all';
      tagButtons.forEach(b => b.classList.toggle('is-active', b === button));
      applyFilter();
    });
  });

  const moreButton = document.getElementById('blog-tags-more');
  const overflowTagButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-overflow-tag]'));
  const moreLabel = moreButton?.textContent?.trim() ?? '';

  moreButton?.addEventListener('click', () => {
    const expanding = overflowTagButtons.some(button => button.hidden);
    overflowTagButtons.forEach(button => {
      button.hidden = !expanding;
    });
    moreButton.textContent = expanding ? (moreButton.dataset.less ?? '') : moreLabel;
  });

  // Landing here via a tag link (e.g. /blog?tag=python from a post's sidebar
  // or another post's tag chip) pre-selects that filter instead of just
  // dropping the visitor on the unfiltered list.
  const requestedTag = new URLSearchParams(window.location.search).get('tag');
  if (requestedTag) {
    const targetButton = tagButtons.find(button => button.getAttribute('data-tag') === requestedTag);
    if (targetButton) {
      if (targetButton.hasAttribute('data-overflow-tag')) {
        overflowTagButtons.forEach(button => {
          button.hidden = false;
        });
        if (moreButton) moreButton.textContent = moreButton.dataset.less ?? '';
      }
      activeTag = requestedTag;
      tagButtons.forEach(button => button.classList.toggle('is-active', button === targetButton));
      applyFilter();
    }
  }
</script>
