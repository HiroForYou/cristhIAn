---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@/utils/slugify.js';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout title="Blog — Cristhian Wiki">
  <Navbar client:load />
  <main>
    <section class="container blog-index">
      <p class="eyebrow">Writing</p>
      <h1>Blog</h1>

      <ul class="blog-index__list">
        {
          posts.map(post => (
            <li>
              <div class="card blog-index__card">
                <span class="blog-index__date">{dateFormatter.format(post.data.date)}</span>
                <h2>
                  <a class="blog-index__title-link" href={`/blog/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </h2>
                <div class="blog-index__tags">
                  {post.data.tags.map(tag => (
                    <a class="tag" href={`/blog/tags/${slugify(tag)}/`}>
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    padding-top: 64px;
  }

  .blog-index__list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .blog-index__card {
    position: relative;
    transition: border-color 0.15s ease;
  }

  .blog-index__card:hover {
    border-color: var(--color-primary-light);
  }

  .blog-index__title-link {
    color: var(--color-text);
  }

  .blog-index__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .blog-index__list h2 {
    font-size: 1.25rem;
    margin: 8px 0;
  }

  .blog-index__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .blog-index__tags {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
</style>
