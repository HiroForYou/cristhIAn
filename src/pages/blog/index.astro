---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@/utils/slugify.js';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = Array.from(new Set(posts.flatMap(post => post.data.tags))).sort((a, b) =>
  a.localeCompare(b)
);

const VISIBLE_TAG_LIMIT = 8;
const visibleTags = allTags.slice(0, VISIBLE_TAG_LIMIT);
const overflowTags = allTags.slice(VISIBLE_TAG_LIMIT);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout
  title="Blog — Cristhian Wiki"
  description="Notes on machine learning engineering, MLOps, and the side projects I build along the way."
>
  <Navbar client:load />
  <main>
    <section class="container blog-index">
      <p class="eyebrow">Writing</p>
      <h1>Blog</h1>

      <label class="blog-search" for="blog-search-input">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          type="text"
          id="blog-search-input"
          placeholder="Search posts or tags…"
          autocomplete="off"
        />
      </label>

      <div class="blog-controls">
        <div class="blog-controls__tags" id="blog-tag-filter">
          <button type="button" class="tag is-active" data-tag="all">All</button>
          {
            visibleTags.map(tag => (
              <button type="button" class="tag" data-tag={slugify(tag)}>
                {tag}
              </button>
            ))
          }
          {
            overflowTags.map(tag => (
              <button type="button" class="tag" data-tag={slugify(tag)} data-overflow-tag hidden>
                {tag}
              </button>
            ))
          }
          {
            overflowTags.length > 0 && (
              <button type="button" class="tag blog-controls__more" id="blog-tags-more">
                +{overflowTags.length} more
              </button>
            )
          }
        </div>

        <div class="blog-controls__sort" id="blog-sort">
          <button type="button" class="btn btn-secondary is-active" data-sort="desc">
            Newest first
          </button>
          <button type="button" class="btn btn-secondary" data-sort="asc">
            Oldest first
          </button>
        </div>
      </div>

      <ul class="blog-index__list" id="blog-post-list">
        {
          posts.map(post => (
            <li
              data-tags={post.data.tags.map(slugify).join(',')}
              data-date={post.data.date.toISOString()}
              data-search={`${post.data.title} ${post.data.tags.join(' ')}`.toLowerCase()}
            >
              <div class="card blog-index__card">
                <span class="blog-index__date">{dateFormatter.format(post.data.date)}</span>
                <h2>
                  <a class="blog-index__title-link" href={`/blog/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </h2>
                <div class="blog-index__tags">
                  {post.data.tags.map(tag => (
                    <a class="tag" href={`/blog?tag=${slugify(tag)}`}>
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="blog-index__empty" id="blog-empty" hidden>
        No posts match this filter.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    padding-top: 64px;
  }

  .blog-search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 360px;
    margin-top: 32px;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text-muted);
    transition: border-color 0.15s ease;
  }

  .blog-search:focus-within {
    border-color: var(--color-primary-light);
  }

  .blog-search svg {
    flex: none;
  }

  .blog-search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .blog-search input:focus {
    outline: none;
  }

  .blog-search input::placeholder {
    color: var(--color-text-muted);
  }

  .blog-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
  }

  .blog-controls__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .blog-controls__tags .tag {
    cursor: pointer;
    border: 1px solid var(--color-tag-border);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .blog-controls__tags .tag.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .blog-controls__more {
    border-style: dashed;
  }

  .blog-controls__sort {
    display: flex;
    gap: 8px;
  }

  .blog-controls__sort .btn {
    padding: 6px 14px;
    font-size: 0.8rem;
  }

  .blog-controls__sort .btn.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .blog-index__list {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .blog-index__card {
    position: relative;
    transition: border-color 0.15s ease;
  }

  .blog-index__card:hover {
    border-color: var(--color-primary-light);
  }

  .blog-index__title-link {
    color: var(--color-text);
  }

  .blog-index__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .blog-index__list h2 {
    font-size: 1.25rem;
    margin: 8px 0;
  }

  .blog-index__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .blog-index__tags {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .blog-index__empty {
    color: var(--color-text-muted);
    margin-top: 24px;
  }
</style>

<script>
  const list = document.getElementById('blog-post-list');
  const items = Array.from(list?.children ?? []);
  const emptyMessage = document.getElementById('blog-empty');

  const tagButtons = Array.from(document.querySelectorAll('#blog-tag-filter [data-tag]'));
  const sortButtons = Array.from(document.querySelectorAll('#blog-sort [data-sort]'));
  const searchInput = document.getElementById('blog-search-input');

  let activeTag = 'all';
  let activeSort = 'desc';
  let searchQuery = '';

  function applyFilter() {
    let visibleCount = 0;
    items.forEach(item => {
      const tags = (item.getAttribute('data-tags') ?? '').split(',');
      const matchesTag = activeTag === 'all' || tags.includes(activeTag);
      const matchesSearch = !searchQuery || (item.getAttribute('data-search') ?? '').includes(searchQuery);
      const visible = matchesTag && matchesSearch;
      item.hidden = !visible;
      if (visible) visibleCount++;
    });
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  }

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilter();
  });

  function applySort() {
    if (!list) return;
    const sorted = [...items].sort((a, b) => {
      const dateA = new Date(a.getAttribute('data-date') ?? 0).getTime();
      const dateB = new Date(b.getAttribute('data-date') ?? 0).getTime();
      return activeSort === 'asc' ? dateA - dateB : dateB - dateA;
    });
    sorted.forEach(item => list.appendChild(item));
  }

  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      activeTag = button.getAttribute('data-tag') ?? 'all';
      tagButtons.forEach(b => b.classList.toggle('is-active', b === button));
      applyFilter();
    });
  });

  sortButtons.forEach(button => {
    button.addEventListener('click', () => {
      activeSort = button.getAttribute('data-sort') ?? 'desc';
      sortButtons.forEach(b => b.classList.toggle('is-active', b === button));
      applySort();
    });
  });

  const moreButton = document.getElementById('blog-tags-more');
  const overflowTagButtons = Array.from(document.querySelectorAll('[data-overflow-tag]'));
  const moreLabel = moreButton?.textContent?.trim() ?? '';

  moreButton?.addEventListener('click', () => {
    const expanding = overflowTagButtons.some(button => button.hidden);
    overflowTagButtons.forEach(button => {
      button.hidden = !expanding;
    });
    moreButton.textContent = expanding ? 'Show less' : moreLabel;
  });

  // Landing here via a tag link (e.g. /blog?tag=python from a post's sidebar
  // or another post's tag chip) pre-selects that filter instead of just
  // dropping the visitor on the unfiltered list.
  const requestedTag = new URLSearchParams(window.location.search).get('tag');
  if (requestedTag) {
    const targetButton = tagButtons.find(button => button.getAttribute('data-tag') === requestedTag);
    if (targetButton) {
      if (targetButton.hasAttribute('data-overflow-tag')) {
        overflowTagButtons.forEach(button => {
          button.hidden = false;
        });
        if (moreButton) moreButton.textContent = 'Show less';
      }
      activeTag = requestedTag;
      tagButtons.forEach(button => button.classList.toggle('is-active', button === targetButton));
      applyFilter();
    }
  }
</script>
