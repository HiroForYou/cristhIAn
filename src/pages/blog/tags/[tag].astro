---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Footer from '@/components/Footer.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@/utils/slugify.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagSlugs = new Map();

  posts.forEach(post => {
    post.data.tags.forEach(tag => {
      const slug = slugify(tag);
      if (!tagSlugs.has(slug)) tagSlugs.set(slug, tag);
    });
  });

  return Array.from(tagSlugs.entries()).map(([slug, tag]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts
        .filter(post => post.data.tags.some(t => slugify(t) === slug))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout title={`Posts tagged "${tag}" — Cristhian Wiki`}>
  <Navbar client:load />
  <main>
    <section class="container tag-page">
      <p class="eyebrow">
        <a href="/blog">← All posts</a>
      </p>
      <h1>
        {posts.length} post{posts.length === 1 ? '' : 's'} tagged &ldquo;{tag}&rdquo;
      </h1>

      <ul class="tag-page__list">
        {
          posts.map(post => (
            <li>
              <a class="card" href={`/blog/${post.slug}/`}>
                <span class="tag-page__date">{dateFormatter.format(post.data.date)}</span>
                <h2>{post.data.title}</h2>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .tag-page {
    padding-top: 64px;
  }

  .tag-page__list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tag-page__list a {
    display: block;
    color: var(--color-text);
  }

  .tag-page__list a:hover {
    color: var(--color-text);
    border-color: var(--color-primary-light);
  }

  .tag-page__list h2 {
    font-size: 1.25rem;
    margin: 8px 0 0;
  }

  .tag-page__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
