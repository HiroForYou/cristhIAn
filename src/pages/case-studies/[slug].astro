---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Footer from '@/components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map(study => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const withProtocol = url => (url.startsWith('//') ? `https:${url}` : url);
---

<Layout title={`${study.data.title} — Cristhian Wiki`} description={study.data.excerpt}>
  <Navbar client:load />
  <main>
    <article class="container case-study-page">
      <h1>{study.data.title}</h1>

      <div class="case-study-page__preview">
        <iframe
          src={withProtocol(study.data.iframe)}
          title={study.data.title}
          frameborder="0"
          allow="accelerometer; autoplay; encrypted-media; gyroscope"
          allowfullscreen
        />
      </div>

      <div class="case-study-page__meta card">
        <p><strong>Idea:</strong> {study.data.info.idea}</p>
        <div class="case-study-page__tags">
          {study.data.info.tech.map(tech => <span class="tag">{tech}</span>)}
        </div>
        <div class="case-study-page__links">
          <a class="btn btn-primary" href={withProtocol(study.data.demo)} target="_blank" rel="noopener noreferrer">
            Live Demo
          </a>
          <a class="btn btn-secondary" href={withProtocol(study.data.src)} target="_blank" rel="noopener noreferrer">
            Source
          </a>
          {study.data.info.links.map(([label, url]) => (
            <a class="btn btn-secondary" href={url} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          ))}
        </div>
      </div>

      <div class="case-study-page__content">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .case-study-page {
    padding-top: 64px;
    max-width: 760px;
  }

  .case-study-page__preview {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #000;
    padding-top: 56.25%;
    margin: 24px 0;
  }

  .case-study-page__preview iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .case-study-page__meta {
    margin-bottom: 32px;
  }

  .case-study-page__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 12px 0 16px;
  }

  .case-study-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .case-study-page__content {
    line-height: 1.75;
  }

  .case-study-page__content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-card);
  }

  .case-study-page__content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 16px;
    overflow-x: auto;
  }

  .case-study-page__content :global(a) {
    color: var(--color-primary);
  }
</style>
