---
import smallProjects from '@/data/smallprojects.json';
---

<div class="small-projects">
  <div class="small-projects__skew" aria-hidden="true"></div>

  <div class="small-projects__inner container">
    <h3 class="small-projects__title">Small Projects</h3>

    <div class="carousel" id="small-projects-carousel">
      <div class="carousel__track">
        {
          smallProjects.map(project => (
            <div class="carousel__slide">
              <div class="card small-project">
                <h4>{project.title}</h4>
                <p>{project.description}</p>
                <div class="small-project__links">
                  <a class="btn btn-primary" href={project.links.demo} target="_blank" rel="noopener noreferrer">
                    Demo
                  </a>
                  <a class="btn btn-secondary" href={project.links.src} target="_blank" rel="noopener noreferrer">
                    Source
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div class="carousel__dots">
        {smallProjects.map((_, i) => <button type="button" class="carousel__dot" data-index={i} aria-label={`Go to slide ${i + 1}`} />)}
      </div>
    </div>
  </div>
</div>

<style>
  .small-projects {
    position: relative;
    margin-top: 64px;
    padding-block: 64px;
  }

  .small-projects__skew {
    position: absolute;
    inset: 0;
    background: var(--color-surface);
    transform: skewY(-3deg);
    z-index: -1;
  }

  .small-projects__title {
    font-size: 1.1rem;
    margin-bottom: 24px;
  }

  .carousel__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 8px;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 82%;
    scroll-snap-align: center;
  }

  .small-project {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .small-project h4 {
    margin: 0 0 8px;
  }

  .small-project p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .small-project__links {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .carousel__dot.is-active {
    background: var(--color-primary);
    transform: scale(1.3);
  }

  @media (min-width: 640px) {
    .carousel__slide {
      flex-basis: 45%;
    }
  }

  @media (min-width: 1000px) {
    .carousel__slide {
      flex-basis: 31%;
    }
  }
</style>

<script>
  const root = document.getElementById('small-projects-carousel');
  const track = root?.querySelector('.carousel__track');
  const slides = Array.from(track?.children ?? []);
  const dots = Array.from(root?.querySelectorAll('.carousel__dot') ?? []);

  let activeIndex = 0;
  let autoplayTimer;

  function goTo(index) {
    const slide = slides[index];
    if (!track || !slide) return;
    // Scroll the track's own scrollLeft directly (never scrollIntoView: it can
    // escape to the document/window and yank the whole page around vertically).
    const targetLeft = slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
    track.scrollTo({ left: targetLeft, behavior: 'smooth' });
  }

  function setActive(index) {
    activeIndex = index;
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      setActive(i);
      goTo(i);
    });
  });

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = slides.indexOf(entry.target);
          if (index !== -1) setActive(index);
        }
      });
    },
    { root: track, threshold: 0.6 }
  );
  slides.forEach(slide => observer.observe(slide));

  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      const next = (activeIndex + 1) % slides.length;
      goTo(next);
    }, 4000);
  }

  function stopAutoplay() {
    clearInterval(autoplayTimer);
  }

  if (slides.length > 1 && root) {
    startAutoplay();
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('touchstart', stopAutoplay, { passive: true });
  }

  setActive(0);
</script>
