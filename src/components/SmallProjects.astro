---
import smallProjects from '@/data/smallprojects.json';
---

<div class="small-projects">
  <h3 class="small-projects__title">Small Projects</h3>
  <div class="small-projects__row">
    {
      smallProjects.map(project => (
        <div class="card small-project">
          <h4>{project.title}</h4>
          <p>{project.description}</p>
          <div class="small-project__links">
            <a class="btn btn-primary" href={project.links.demo} target="_blank" rel="noopener noreferrer">
              Demo
            </a>
            <a class="btn btn-secondary" href={project.links.src} target="_blank" rel="noopener noreferrer">
              Source
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .small-projects {
    margin-top: 48px;
  }

  .small-projects__title {
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .small-projects__row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
  }

  .small-project {
    flex: 0 0 260px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }

  .small-project h4 {
    margin: 0 0 8px;
  }

  .small-project p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .small-project__links {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
</style>
