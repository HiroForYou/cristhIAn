---
import smallProjects from '@/data/smallprojects.json';
---

<div class="small-projects" id="small-projects-carousel">
  <div class="small-projects__skew" aria-hidden="true"></div>

  <div class="container">
    <h3 class="small-projects__title">Small Projects</h3>
  </div>

  <div class="carousel">
    <div class="carousel__track">
      {
        smallProjects.map(project => (
          <div class="carousel__slide">
            <div class="card small-project">
              <h4>{project.title}</h4>
              <p>{project.description}</p>
              <div class="small-project__links">
                <a class="btn btn-primary" href={project.links.demo} target="_blank" rel="noopener noreferrer">
                  Demo
                </a>
                <a class="btn btn-secondary" href={project.links.src} target="_blank" rel="noopener noreferrer">
                  Source
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="container">
    <div class="carousel__dots" id="small-projects-dots"></div>
  </div>
</div>

<style>
  .small-projects {
    position: relative;
    margin-top: 64px;
    padding-block: 64px;
  }

  .small-projects__skew {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    background: var(--color-surface);
    transform: skewY(-3deg);
    z-index: -1;
  }

  .small-projects__title {
    font-size: 1.1rem;
    margin-bottom: 24px;
  }

  .carousel {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .carousel__track {
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 5vw;
    padding: 0 5vw 8px;
    scrollbar-width: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .small-project {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .small-project h4 {
    margin: 0 0 8px;
  }

  .small-project p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .small-project__links {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .carousel__dot.is-active {
    background: var(--color-primary);
    transform: scale(1.3);
  }

  @media (min-width: 640px) {
    .carousel__slide {
      /* exactly 2 per page — no partial 3rd peeking in */
      flex-basis: calc((100% - 16px) / 2);
    }
  }

  @media (min-width: 1000px) {
    .carousel__slide {
      /* exactly 3 per page — no partial 4th peeking in */
      flex-basis: calc((100% - 32px) / 3);
    }
  }
</style>

<script>
  const root = document.getElementById('small-projects-carousel');
  const track = root?.querySelector('.carousel__track');
  const dotsContainer = document.getElementById('small-projects-dots');
  const slides = Array.from(track?.children ?? []);

  // One dot per *page* (a page = however many cards fit per the current
  // breakpoint), not one per card — mirrors the CSS breakpoints exactly.
  function getSlidesPerPage() {
    if (window.matchMedia('(min-width: 1000px)').matches) return 3;
    if (window.matchMedia('(min-width: 640px)').matches) return 2;
    return 1;
  }

  let slidesPerPage = getSlidesPerPage();
  let pageCount = Math.max(1, Math.ceil(slides.length / slidesPerPage));
  let dots = [];
  let activePage = 0;
  let autoplayTimer;

  function renderDots() {
    if (!dotsContainer) return;
    dotsContainer.innerHTML = '';
    dots = Array.from({ length: pageCount }, (_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'carousel__dot';
      dot.setAttribute('aria-label', `Go to page ${i + 1}`);
      dot.addEventListener('click', () => {
        setActivePage(i);
        goToPage(i);
      });
      dotsContainer.appendChild(dot);
      return dot;
    });
  }

  function goToPage(pageIndex) {
    const slide = slides[Math.min(pageIndex * slidesPerPage, slides.length - 1)];
    if (!track || !slide) return;
    // Scroll the track's own scrollLeft directly (never scrollIntoView: it can
    // escape to the document/window and yank the whole page around vertically).
    const targetLeft = pageIndex === 0 ? 0 : slide.offsetLeft;
    track.scrollTo({ left: targetLeft, behavior: 'smooth' });
  }

  function setActivePage(pageIndex) {
    activePage = pageIndex;
    dots.forEach((dot, i) => dot.classList.toggle('is-active', i === pageIndex));
  }

  // With multiple slides visible at once, several intersect simultaneously —
  // track the whole visible set and use the leftmost to derive the active page.
  const visibleIndexes = new Set();
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        const index = slides.indexOf(entry.target);
        if (index === -1) return;
        if (entry.isIntersecting) visibleIndexes.add(index);
        else visibleIndexes.delete(index);
      });
      if (visibleIndexes.size) {
        setActivePage(Math.floor(Math.min(...visibleIndexes) / slidesPerPage));
      }
    },
    { root: track, threshold: 0.6 }
  );
  slides.forEach(slide => observer.observe(slide));

  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      const next = (activePage + 1) % pageCount;
      goToPage(next);
    }, 4000);
  }

  function stopAutoplay() {
    clearInterval(autoplayTimer);
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const next = getSlidesPerPage();
      if (next === slidesPerPage) return;
      slidesPerPage = next;
      pageCount = Math.max(1, Math.ceil(slides.length / slidesPerPage));
      renderDots();
      setActivePage(0);
    }, 200);
  });

  renderDots();
  if (pageCount > 1 && root) {
    startAutoplay();
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('touchstart', stopAutoplay, { passive: true });
  }
  setActivePage(0);
</script>
