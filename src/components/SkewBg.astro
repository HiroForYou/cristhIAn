---
interface Props {
  fullBleed?: boolean;
}
const { fullBleed = false } = Astro.props;
---

<div class={`skew-bg ${fullBleed ? 'skew-bg--full-bleed' : ''}`} aria-hidden="true"></div>

<style>
  .skew-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    height: 90%;
    min-height: 320px;
    background: var(--color-surface);
    transform: skewY(-3deg);
    z-index: -1;
    pointer-events: none;
  }

  .skew-bg--full-bleed {
    width: 100vw;
    left: 50%;
    right: auto;
    margin-left: -50vw;
    top: 0;
    height: 100%;
  }
</style>
