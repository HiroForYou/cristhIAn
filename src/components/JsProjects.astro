---
import jsProjects from '@/data/jsprojects.json';

const withProtocol = url => (url.startsWith('//') ? `https:${url}` : url);
---

<div class="js-projects">
  <h3 class="js-projects__title">Deep Learning with JavaScript 💛</h3>
  {
    jsProjects.map(project => (
      <div class="card js-project">
        <div class="js-project__body">
          <h4>{project.title}</h4>
          <p>{project.description}</p>
          <div class="js-project__links">
            <a class="btn btn-primary" href={`${withProtocol(project.links.github)}/archive/master.zip`}>
              Download
            </a>
            <a class="btn btn-secondary" href={withProtocol(project.links.github)} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
        </div>
        <div class="js-project__preview">
          <iframe
            src={withProtocol(project.links.codepen)}
            title={project.title}
            loading="lazy"
            frameborder="0"
          />
        </div>
      </div>
    ))
  }
</div>

<style>
  .js-projects {
    margin-top: 48px;
  }

  .js-projects__title {
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .js-project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
  }

  .js-project p {
    color: var(--color-text-muted);
  }

  .js-project__links {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  .js-project__preview {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #000;
    padding-top: 56.25%;
  }

  .js-project__preview iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 720px) {
    .js-project {
      grid-template-columns: 1fr;
    }
  }
</style>
