---
const age = new Date().getFullYear() - 1998;
const swatches = ['var(--color-primary)', '#6a98f0', 'var(--gradient-primary)', '#f8f8f8', 'var(--color-surface)'];
---

<div class="hero-card">
  <div class="hero-card__titlebar">
    <span class="hero-card__dot hero-card__dot--red"></span>
    <span class="hero-card__dot hero-card__dot--yellow"></span>
    <span class="hero-card__dot hero-card__dot--green"></span>
    <span class="hero-card__filename">person.js</span>
  </div>
  <pre class="hero-card__code"><span class="hc-line"><span class="hc-ln">1</span>  <span class="hc-kw">class</span> <span class="hc-id">Person</span> {'{'}</span
><span class="hc-line"><span class="hc-ln">2</span>    <span class="hc-kw">constructor</span>() {'{'}</span
><span class="hc-line"><span class="hc-ln">3</span>      <span class="hc-kw">this</span>.<span class="hc-id">name</span> = <span class="hc-str">"Cristhian Wiki"</span>;</span
><span class="hc-line"><span class="hc-ln">4</span>      <span class="hc-kw">this</span>.<span class="hc-id">traits</span> = [<span class="hc-str">"RESEARCH"</span>, <span class="hc-str">"DEV"</span>];</span
><span class="hc-line"><span class="hc-ln">5</span>      <span class="hc-kw">this</span>.<span class="hc-id">age</span> = <span class="hc-num">{age}</span>;</span
><span class="hc-line"><span class="hc-ln">6</span>    {'}'}</span
><span class="hc-line"><span class="hc-ln">7</span>  {'}'}</span
></pre>

  <div class="hero-card__palette">
    {
      swatches.map(color => (
        <button type="button" class="hero-card__swatch" style={`background:${color}`} data-color={color} aria-label={`Copy color ${color}`}>
          <span class="hero-card__tooltip">Copied</span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .hero-card {
    position: relative;
    flex-shrink: 0;
    animation: hero-card-in 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes hero-card-in {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-card__titlebar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .hero-card__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .hero-card__dot--red {
    background: #ff5f56;
  }

  .hero-card__dot--yellow {
    background: #ffbd2e;
  }

  .hero-card__dot--green {
    background: #27c93f;
  }

  .hero-card__filename {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .hero-card__code {
    margin: 0;
    padding: 24px 34px 30px;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--color-text);
    white-space: pre;
    min-width: 360px;
  }

  .hc-line {
    display: block;
  }

  .hc-ln {
    display: inline-block;
    width: 1.4em;
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .hc-kw {
    color: var(--color-primary-light);
    font-weight: 600;
  }

  .hc-id {
    color: var(--color-text);
    font-weight: 700;
  }

  .hc-str,
  .hc-num {
    color: var(--color-primary);
  }

  .hero-card__palette {
    position: absolute;
    bottom: -34px;
    left: -40px;
    display: flex;
    gap: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 8px;
    border-radius: 8px;
  }

  .hero-card__swatch {
    position: relative;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .hero-card__swatch:hover {
    transform: scale(1.1);
  }

  .hero-card__swatch:active {
    transform: scale(0.9);
  }

  .hero-card__tooltip {
    position: absolute;
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    padding: 4px 8px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .hero-card__swatch.copied .hero-card__tooltip {
    animation: hero-card-tooltip 1s ease forwards;
  }

  @keyframes hero-card-tooltip {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(4px);
    }
    20% {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero-card {
      margin-top: 48px;
      align-self: center;
    }

    .hero-card__code {
      min-width: 0;
      font-size: 0.82rem;
    }

    .hero-card__palette {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>

<script>
  document.querySelectorAll('.hero-card__swatch').forEach(button => {
    button.addEventListener('click', async () => {
      const color = button.getAttribute('data-color') ?? '';
      try {
        await navigator.clipboard.writeText(color);
      } catch {
        // clipboard API unavailable — swallow, the tooltip still gives feedback
      }
      button.classList.remove('copied');
      // restart the animation
      void button.offsetWidth;
      button.classList.add('copied');
    });
  });
</script>
