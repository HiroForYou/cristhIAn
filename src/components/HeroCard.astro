<div class="hero-card">
  <div class="hero-card__frame" id="hero-card-frame">
    <div class="hero-card__titlebar">
      <span class="hero-card__dot hero-card__dot--red"></span>
      <span class="hero-card__dot hero-card__dot--yellow"></span>
      <span class="hero-card__dot hero-card__dot--green"></span>
      <span class="hero-card__filename">profile.py</span>
      <span class="hero-card__meta">Python 3.12</span>
    </div>

    <div class="hero-card__code" id="hero-card-code">
      <div class="hero-card__gutter" id="hero-card-gutter"></div>
      <pre class="hero-card__lines" id="hero-card-lines"></pre>
    </div>

    <div class="hero-card__terminal">
      <div class="hero-card__terminal-label">
        <span>TERMINAL</span>
        <span class="hero-card__terminal-rule"></span>
      </div>
      <div class="hero-card__terminal-body" id="hero-card-terminal">
        <div class="hc-line" id="hc-cmd-line">
          <span class="hc-prompt">$ </span><span id="hc-cmd-text"></span><span class="hc-caret" id="hc-caret"></span>
        </div>
        <div class="hc-line" data-output="FastAPI APIs">
          <span class="hc-check">  ✓  </span><span class="hc-output">FastAPI APIs</span>
        </div>
        <div class="hc-line" data-output="ML models trained">
          <span class="hc-check">  ✓  </span><span class="hc-output">ML models trained</span>
        </div>
        <div class="hc-line" data-output="AWS deployment">
          <span class="hc-check">  ✓  </span><span class="hc-output">AWS deployment</span>
        </div>
        <div class="hc-line" data-output="Production ready">
          <span class="hc-check">  ✓  </span><span class="hc-output">Production ready</span>
        </div>
        <div class="hc-line hero-card__status">
          <span class="hero-card__status-dot"></span>
          <span class="hero-card__status-label">Status:</span>
          <span class="hero-card__status-value">Shipping ML systems in production</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-card {
    position: relative;
    flex-shrink: 0;
    width: 100%;
    max-width: 580px;
    perspective: 1400px;
  }

  .hero-card__frame {
    border-radius: var(--radius-card);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-surface), white 8%),
      var(--color-surface) 65%
    );
    border: 1px solid var(--color-border);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.5);
    animation: hero-card-in 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both,
      hero-card-float 7s ease-in-out 0.5s infinite;
    transition: transform 0.2s ease-out;
    will-change: transform;
  }

  @keyframes hero-card-in {
    from {
      opacity: 0;
      transform: translateY(-16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-card-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .hero-card__titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-card__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .hero-card__dot--red {
    background: #ff5f57;
  }

  .hero-card__dot--yellow {
    background: #febc2e;
  }

  .hero-card__dot--green {
    background: #28c840;
  }

  .hero-card__filename {
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .hero-card__meta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .hero-card__code {
    display: flex;
    padding: 20px 18px 18px 20px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.85;
    max-width: 100%;
    overflow: hidden;
  }

  .hero-card__gutter {
    flex: none;
    text-align: right;
    color: var(--color-text-muted);
    opacity: 0.5;
    user-select: none;
    padding-right: 12px;
    margin-right: 12px;
    border-right: 1px solid var(--color-border);
    min-width: 14px;
  }

  .hero-card__lines {
    margin: 0;
    flex: 1;
    min-width: 0;
    white-space: pre;
    overflow: hidden;
  }

  .hc-caret {
    display: inline-block;
    width: 7px;
    height: 1em;
    background: var(--color-primary-light);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: hero-card-blink 1s step-end infinite;
  }

  @keyframes hero-card-blink {
    50% {
      opacity: 0;
    }
  }

  .hero-card__terminal {
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface), black 6%);
    padding: 13px 22px 16px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.85;
  }

  .hero-card__terminal-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .hero-card__terminal-label span:first-child {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .hero-card__terminal-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .hero-card__terminal-body div {
    white-space: pre;
  }

  .hero-card__terminal-body .hc-line {
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .hero-card__terminal-body .hc-line.is-visible {
    opacity: 1;
    transform: none;
  }

  .hc-prompt {
    color: var(--color-text-muted);
  }

  .hc-check {
    color: #3fb950;
    font-weight: 700;
  }

  .hc-output {
    color: var(--color-text-muted);
  }

  .hero-card__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 11px;
  }

  .hero-card__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fb950;
    box-shadow: 0 0 8px #3fb950;
    animation: hero-card-pulse 2s ease-in-out infinite;
    flex: none;
  }

  @keyframes hero-card-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.8);
    }
  }

  .hero-card__status-label {
    color: var(--color-text-muted);
  }

  .hero-card__status-value {
    color: var(--color-primary-light);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .hero-card {
      margin-top: 48px;
      align-self: center;
      max-width: 100%;
    }
  }

  @media (max-width: 560px) {
    .hero-card__code,
    .hero-card__terminal {
      font-size: 0.66rem;
    }

    .hero-card__code {
      padding-left: 14px;
      padding-right: 10px;
    }

    .hero-card__gutter {
      min-width: 12px;
      padding-right: 8px;
      margin-right: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-card__frame {
      animation: hero-card-in 0.4s ease both;
    }
  }
</style>

<style is:global>
  /* These target elements created at runtime via document.createElement
     (the code gutter numbers + syntax-highlighted tokens), so they can't
     carry Astro's scoped data-astro-cid attribute — scoping them like the
     rest of this component's styles would silently never match. */
  .hero-card__gutter span {
    display: block;
  }

  .hero-card__lines div {
    min-height: 1.85em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .hero-card__lines div.is-visible {
    opacity: 1;
    transform: none;
  }

  .hero-card .hc-kw {
    color: var(--color-primary-light);
    font-weight: 600;
  }

  .hero-card .hc-cls {
    color: var(--color-text);
    font-weight: 700;
  }

  .hero-card .hc-mod {
    color: var(--color-text-muted);
  }

  .hero-card .hc-str {
    color: var(--color-primary);
  }
</style>

<script>
  const CODE = [
    [['from', 'kw'], [' ', ''], ['fastapi', 'mod'], [' ', ''], ['import', 'kw'], [' ', ''], ['FastAPI', 'cls']],
    [['import', 'kw'], [' ', ''], ['torch', 'mod']],
    [],
    [['class', 'kw'], [' ', ''], ['MLEngineer', 'cls'], [':', '']],
    [['    ', ''], ['def', 'kw'], [' ', ''], ['__init__', 'cls'], ['(', ''], ['self', 'kw'], ['):', '']],
    [['        ', ''], ['self', 'kw'], ['.name = ', ''], ['"Cristhian Wiki"', 'str']],
    [['        ', ''], ['self', 'kw'], ['.role = ', ''], ['"Machine Learning Engineer"', 'str']],
    [['        ', ''], ['self', 'kw'], ['.stack = [', ''], ['"PyTorch"', 'str'], [', ', ''], ['"FastAPI"', 'str'], [', ', ''], ['"AWS"', 'str'], [']', '']],
    [],
    [['    ', ''], ['def', 'kw'], [' ', ''], ['build', 'cls'], ['(', ''], ['self', 'kw'], ['):', '']],
    [['        ', ''], ['return', 'kw'], [' ', ''], ['"production ML systems"', 'str']],
  ];

  const gutter = document.getElementById('hero-card-gutter');
  const linesEl = document.getElementById('hero-card-lines');
  const terminal = document.getElementById('hero-card-terminal');
  const frame = document.getElementById('hero-card-frame');

  if (gutter && linesEl && terminal) {
    CODE.forEach((_, i) => {
      const num = document.createElement('span');
      num.textContent = String(i + 1);
      gutter.appendChild(num);

      const line = document.createElement('div');
      const tokens = CODE[i];
      if (!tokens.length) {
        line.innerHTML = '&nbsp;';
      } else {
        tokens.forEach(([text, cls]) => {
          const span = document.createElement('span');
          if (cls) span.className = `hc-${cls}`;
          span.textContent = text;
          line.appendChild(span);
        });
      }
      linesEl.appendChild(line);
    });

    const lineEls = Array.from(linesEl.children);
    const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

    // The terminal's rows all exist in the DOM from the start (hidden via
    // opacity, not appended later) so revealing them never changes the
    // card's height — only their own opacity/transform animates in.
    const cmdLine = document.getElementById('hc-cmd-line');
    const cmdText = document.getElementById('hc-cmd-text');
    const caret = document.getElementById('hc-caret');
    const outputRows = Array.from(terminal.querySelectorAll('[data-output]'));
    const statusRow = terminal.querySelector('.hero-card__status');

    async function runSequence() {
      for (const line of lineEls) {
        line.classList.add('is-visible');
        await sleep(90);
      }
      await sleep(450);

      cmdLine?.classList.add('is-visible');
      const command = 'python profile.py';
      for (let i = 1; i <= command.length; i++) {
        if (cmdText) cmdText.textContent = command.slice(0, i);
        await sleep(45);
      }
      caret?.remove();
      await sleep(350);

      for (const row of outputRows) {
        row.classList.add('is-visible');
        await sleep(280);
      }

      await sleep(250);
      statusRow?.classList.add('is-visible');
    }

    runSequence();
  }

  // Subtle mouse-follow tilt, disabled for reduced-motion and touch-only devices.
  if (frame && window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    let raf = null;
    window.addEventListener('mousemove', event => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = null;
        const x = event.clientX / window.innerWidth - 0.5;
        const y = event.clientY / window.innerHeight - 0.5;
        frame.style.transform = `rotateY(${x * 5}deg) rotateX(${-y * 5}deg)`;
      });
    });
  }
</script>
