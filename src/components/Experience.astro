---
import { experience } from '@/data/experience.js';

const VISIBLE_COUNT = 4;
const visibleEntries = experience.slice(0, VISIBLE_COUNT);
const olderEntries = experience.slice(VISIBLE_COUNT);
---

<section id="experience">
  <div class="container">
    <p class="eyebrow">Career</p>
    <h2>Experience</h2>

    <ol class="timeline">
      {
        visibleEntries.map(entry => (
          <li class="timeline__item">
            <span class="timeline__dot" />
            <div class="timeline__content card">
              <div class="timeline__head">
                <h3>{entry.role}</h3>
                <span class="timeline__date">{entry.dateRange}</span>
              </div>
              <p class="timeline__company">{entry.company}</p>
              <ul>
                {entry.bullets.map(bullet => <li>{bullet}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
      {
        olderEntries.map(entry => (
          <li class="timeline__item timeline__item--older" hidden>
            <span class="timeline__dot" />
            <div class="timeline__content card">
              <div class="timeline__head">
                <h3>{entry.role}</h3>
                <span class="timeline__date">{entry.dateRange}</span>
              </div>
              <p class="timeline__company">{entry.company}</p>
              <ul>
                {entry.bullets.map(bullet => <li>{bullet}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    {
      olderEntries.length > 0 && (
        <button type="button" class="btn btn-secondary timeline__toggle" id="experience-toggle">
          Show {olderEntries.length} earlier role{olderEntries.length === 1 ? '' : 's'}
        </button>
      )
    }
  </div>
</section>

<script>
  const toggle = document.getElementById('experience-toggle');
  const olderItems = document.querySelectorAll('.timeline__item--older');

  toggle?.addEventListener('click', () => {
    const expanding = toggle.getAttribute('data-expanded') !== 'true';
    olderItems.forEach(item => {
      item.hidden = !expanding;
    });
    toggle.setAttribute('data-expanded', String(expanding));
    toggle.textContent = expanding
      ? 'Show less'
      : `Show ${olderItems.length} earlier role${olderItems.length === 1 ? '' : 's'}`;
  });
</script>

<style>
  /* Education directly follows this section; without trimming, both
     sides' clamp()-based padding stack into an oversized gap. */
  #experience {
    padding-bottom: 40px;
  }

  .timeline {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-border);
  }

  .timeline__item {
    position: relative;
    padding-left: 32px;
    margin-bottom: 24px;
  }

  .timeline__dot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-primary-light);
  }

  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .timeline__head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .timeline__date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .timeline__company {
    color: var(--color-primary);
    font-weight: 600;
    margin: 4px 0 12px;
  }

  .timeline__content ul {
    margin: 0;
    padding-left: 18px;
    color: var(--color-text-muted);
  }

  .timeline__content li {
    margin-bottom: 6px;
  }

  .timeline__toggle {
    margin-top: 8px;
  }
</style>
