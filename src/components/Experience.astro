---
import { experience } from '@/data/experience.js';
import { getLang, pick, useTranslations } from '@/i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

// Roles on one spine, oldest first.
const stops = experience
  .map(entry => ({
    start: entry.start,
    period: pick(entry.period, lang),
    title: pick(entry.role, lang),
    place: entry.company,
    sub: pick(entry.location, lang),
    current: Boolean(entry.current),
    bullets: pick(entry.bullets, lang),
  }))
  .sort((a, b) => a.start.localeCompare(b.start));
---

<section id="experience">
  <div class="container">
    <p class="eyebrow"><b>02</b>{t('exp.eyebrow')}</p>
    <h2 class="section-title" set:html={t('exp.title')} />

    <div class="tl" id="timeline">
      <span class="tl-spine" aria-hidden="true"></span>
      <span class="tl-fill" aria-hidden="true"></span>
      <ol class="tl-ol">
        {
          stops.map(stop => (
            <li class="st">
              <div class="st-year">
                <b>{stop.start.slice(0, 4)}</b>
                {stop.period}
              </div>
              <span class="st-dot" aria-hidden="true" />
              <div class="st-body">
                <h3>{stop.title}</h3>
                <p class="st-place">
                  {stop.place}
                  {stop.sub && <span> · {stop.sub}</span>}
                </p>
                {stop.current && (
                  <p class="st-status">
                    <b aria-hidden="true" />
                    {t('exp.current')}
                  </p>
                )}
                <ul>
                  {stop.bullets.map(bullet => <li>{bullet}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
        <li class="st st-next">
          <div class="st-year"><b>{t('exp.next')}</b></div>
          <span class="st-dot" aria-hidden="true"></span>
          <div class="st-body">
            <a href="#contact" class="nxt">
              <p>
                <small>{t('exp.nextStop')}</small>
                <Fragment set:html={t('exp.yourTeam')} />
              </p>
              <span class="btn btn-primary">{t('exp.talk')}</span>
            </a>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  // The fill grows to wherever the viewport's centre line sits inside the
  // timeline; every stop the fill has passed gets `is-lit`. Writes go
  // straight to the DOM, at most once per frame.
  const timeline = document.getElementById('timeline');
  const fill = timeline?.querySelector<HTMLElement>('.tl-fill');
  const stops = timeline ? [...timeline.querySelectorAll<HTMLElement>('.st')] : [];

  if (timeline && fill) {
    let frame = 0;

    const measure = () => {
      frame = 0;
      const rect = timeline.getBoundingClientRect();
      const raw = (window.innerHeight * 0.5 - rect.top) / Math.max(1, rect.height);
      const progress = Math.min(1, Math.max(0, raw));
      fill.style.transform = `scaleY(${progress})`;
      const reach = progress * timeline.offsetHeight;
      stops.forEach(stop => {
        stop.classList.toggle('is-lit', stop.offsetTop + 10 <= reach + 1);
      });
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(measure);
    };

    timeline.classList.add('is-ready');
    measure();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
  }
</script>

<style>
  /* Education directly follows; without trimming, both
     sides' clamp()-based padding stack into an oversized gap. */
  #experience {
    padding-bottom: 40px;
  }

  .tl {
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --yc: 170px;
    --sx: calc(var(--yc) + 22px);
    position: relative;
    margin: 56px 0 0;
  }

  .tl-ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-spine,
  .tl-fill {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: var(--sx);
    width: 1px;
  }

  .tl-spine {
    background: var(--color-border);
  }

  .tl-fill {
    width: 2px;
    margin-left: -0.5px;
    background: var(--color-primary);
    transform: scaleY(0);
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* Without JS the fill never moves, so show it fully drawn. */
  .tl:not(.is-ready) .tl-fill {
    transform: none;
  }

  .st {
    position: relative;
    display: grid;
    grid-template-columns: var(--yc) 44px minmax(0, 1fr);
    padding: 0 0 clamp(36px, 5vw, 56px);
  }

  .st-year {
    padding-top: 2px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .st-year b {
    display: block;
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 6px;
    color: var(--color-text);
    transition: color 0.6s var(--ease);
  }

  .st-dot {
    position: relative;
    justify-self: center;
    margin-top: 8px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 18%, transparent);
    transition:
      background-color 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      transform 0.6s var(--ease);
  }

  .st-body {
    max-width: 760px;
    transition: transform 0.8s var(--ease);
  }

  .st-body h3,
  .st-place,
  .st li {
    transition: color 0.7s var(--ease);
  }

  .st h3 {
    margin: 2px 0 0;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    line-height: 1.3;
    color: var(--color-text);
  }

  .st-place {
    margin: 6px 0 0;
    font-weight: 600;
    color: var(--color-primary);
  }

  .st-place span {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .st-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 12px 0 0;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition:
      background-color 0.6s var(--ease),
      color 0.6s var(--ease);
  }

  .st-status b {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    animation: st-pulse 1.8s var(--ease) infinite;
  }

  @keyframes st-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6);
    }
    100% {
      box-shadow: 0 0 0 7px rgba(255, 255, 255, 0);
    }
  }

  .st ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  .st li {
    position: relative;
    padding: 6px 0 6px 18px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .st li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15px;
    width: 8px;
    height: 1px;
    background: var(--color-text-muted);
    opacity: 0.6;
  }

  /* Unlit state only applies once the script is running, so the timeline
     stays fully readable without JS. */
  .tl.is-ready .st:not(.is-lit) .st-year b,
  .tl.is-ready .st:not(.is-lit) .st-body h3,
  .tl.is-ready .st:not(.is-lit) .st-place,
  .tl.is-ready .st:not(.is-lit) .st-place span,
  .tl.is-ready .st:not(.is-lit) li {
    color: color-mix(in srgb, var(--color-text-muted) 70%, transparent);
  }

  .tl.is-ready .st:not(.is-lit) .st-dot {
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-text-muted);
    transform: scale(0.9);
  }

  .tl.is-ready .st:not(.is-lit) .st-body {
    transform: translateX(-6px);
  }

  .tl.is-ready .st:not(.is-lit) .st-status {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .st-next .st-body,
  .tl.is-ready .st-next:not(.is-lit) .st-body {
    transform: none;
  }

  .nxt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 28px 30px;
    border-radius: 20px;
    border: 1.5px dashed var(--color-border);
    color: var(--color-text);
    transition:
      border-color 0.5s var(--ease),
      background-color 0.5s var(--ease);
  }

  .nxt:hover {
    border-color: var(--color-primary);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .nxt p {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
  }

  .nxt p small {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nxt em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-primary);
  }

  @media (max-width: 759px) {
    .tl {
      --sx: 6px;
    }

    .st {
      grid-template-columns: 28px minmax(0, 1fr);
      padding-bottom: 40px;
    }

    .st-year {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      margin-bottom: 10px;
    }

    .st-year b {
      display: inline;
      font-size: 1.25rem;
      margin-right: 10px;
    }

    .st-dot {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      margin: 4px 0 0;
    }

    .st-body {
      grid-column: 2;
    }

    .nxt {
      padding: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-year b,
    .st-dot,
    .st-body,
    .st-body h3,
    .st-place,
    .st li,
    .st-status {
      transition: none;
    }

    .st-status b {
      animation: none;
    }

    .tl.is-ready .st:not(.is-lit) .st-body {
      transform: none;
    }
  }
</style>
