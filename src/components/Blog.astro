---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const excerptOf = post => {
  if (post.data.excerpt) return post.data.excerpt;
  const plain = post.body.replace(/[#*_`>[\]()!-]/g, ' ').replace(/\s+/g, ' ').trim();
  return plain.slice(0, 140) + (plain.length > 140 ? '…' : '');
};

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section id="blog">
  <div class="container">
    <p class="eyebrow">Writing</p>
    <h2>From the Blog</h2>

    {
      posts.length === 0 ? (
        <p class="blog__empty">New posts coming soon.</p>
      ) : (
        <div class="blog-grid">
          {posts.map(post => (
            <a class="card blog-card" href={`/blog/${post.slug}/`}>
              <span class="blog-card__date">{dateFormatter.format(post.data.date)}</span>
              <h3>{post.data.title}</h3>
              <p>{excerptOf(post)}</p>
            </a>
          ))}
        </div>
      )
    }

    <a class="blog__all" href="/blog">All posts →</a>
  </div>
</section>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .blog-card {
    display: block;
    color: var(--color-text);
  }

  .blog-card:hover {
    color: var(--color-text);
    border-color: var(--color-lilac);
  }

  .blog-card__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .blog-card h3 {
    font-size: 1.1rem;
    margin: 8px 0;
  }

  .blog-card p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .blog__empty {
    color: var(--color-text-muted);
  }

  .blog__all {
    display: inline-block;
    margin-top: 24px;
    font-weight: 600;
    color: var(--color-orange);
  }
</style>
