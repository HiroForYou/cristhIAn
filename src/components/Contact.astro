---
import { getLang, useTranslations } from '@/i18n';

const EMAIL = 'christiansanchezsaune@gmail.com';
const LINKEDIN_URL = 'https://linkedin.com/in/cristhian-wiki/';
const GITHUB_URL = 'https://github.com/HiroForYou';

const t = useTranslations(getLang(Astro.url.pathname));

// Each letter is its own span so it can hop on hover; words stay
// unbreakable so a line never wraps mid-word.
const lines = [
  { text: t('contact.line1') },
  { text: t('contact.line2'), accent: t('contact.accent') },
];
const heading = `${t('contact.line1')} ${t('contact.line2')} ${t('contact.accent')}`;
const toWords = (text: string) => text.split(' ').map(word => Array.from(word));
---

<section id="contact" class="contact-section">
  <div class="container">
    <p class="eyebrow"><b>06</b>{t('contact.eyebrow')}</p>
    <h2 class="ct-h" aria-label={heading}>
      {
        lines.map(line => (
          <span class="ct-line" aria-hidden="true">
            {toWords(line.text).map((chars, i, words) => (
              <>
                <span class="ct-w">{chars.map(c => <span class="ct-ch">{c}</span>)}</span>
                {i < words.length - 1 ? ' ' : ''}
              </>
            ))}
            {line.accent && (
              <>
                {' '}
                <em>
                  {toWords(line.accent).map(chars => (
                    <span class="ct-w">{chars.map(c => <span class="ct-ch">{c}</span>)}</span>
                  ))}
                </em>
              </>
            )}
          </span>
        ))
      }
    </h2>
    <p class="ct-text">{t('contact.text')}</p>

    <div class="ct-grid">
      <div>
        <p class="ct-label">{t('contact.write')}</p>
        <div class="ct-mail">
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <button
            type="button"
            class="ct-copy"
            id="ct-copy"
            data-email={EMAIL}
            data-copied={t('contact.copied')}
            data-copied-status={t('contact.copiedStatus')}
            aria-label={t('contact.copyLabel')}
          >
            {t('contact.copy')}
          </button>
          <span class="sr-only" id="ct-copy-status" aria-live="polite"></span>
        </div>
        <div class="ct-links">
          <a class="btn btn-secondary" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"></path>
            </svg>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-secondary" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.2.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
            </svg>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <a class="ct-badge" href={`mailto:${EMAIL}`} aria-label={`${t('contact.badgeLabel')} ${EMAIL}`}>
        <svg class="ct-badge__ring" viewBox="0 0 156 156" aria-hidden="true">
          <defs>
            <path id="ct-badge-circle" d="M78 78 m-60 0 a60 60 0 1 1 120 0 a60 60 0 1 1 -120 0"></path>
          </defs>
          <text font-family="var(--font-mono)" font-size="11.5" letter-spacing="3.2" fill="currentColor">
            <textPath href="#ct-badge-circle">{t('contact.badge').repeat(3)}</textPath>
          </text>
        </svg>
        <span class="ct-badge__core" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  const heading = document.querySelector<HTMLElement>('.ct-h');
  heading?.addEventListener('pointerover', event => {
    const letter = event.target as HTMLElement;
    if (!letter.classList.contains('ct-ch') || letter.classList.contains('is-hop')) return;
    letter.classList.add('is-hop');
    letter.addEventListener('animationend', () => letter.classList.remove('is-hop'), { once: true });
  });

  const copyButton = document.getElementById('ct-copy');
  const copyStatus = document.getElementById('ct-copy-status');
  const copyLabel = copyButton?.textContent?.trim() ?? '';
  let resetTimer = 0;

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const field = document.createElement('textarea');
      field.value = email;
      document.body.appendChild(field);
      field.select();
      document.execCommand('copy');
      field.remove();
    }
    copyButton.textContent = copyButton.dataset.copied ?? '';
    copyButton.classList.add('is-done');
    if (copyStatus) copyStatus.textContent = copyButton.dataset.copiedStatus ?? '';
    clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyButton.textContent = copyLabel;
      copyButton.classList.remove('is-done');
      if (copyStatus) copyStatus.textContent = '';
    }, 2200);
  });
</script>

<style>
  .contact-section {
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    /* Projects' own bottom padding already does most of the work here —
       the default section top padding on top of that was compounding into
       a much bigger gap than any other section-to-section transition. */
    padding-top: 24px;
  }

  .ct-h {
    margin: 12px 0 0;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
  }

  .ct-line {
    display: block;
  }

  .ct-w {
    display: inline-block;
    white-space: nowrap;
  }

  .ct-ch {
    display: inline-block;
    will-change: transform;
  }

  .ct-ch.is-hop {
    animation: ct-hop 0.62s var(--ease);
  }

  .ct-h em {
    color: var(--color-primary);
  }

  @keyframes ct-hop {
    0% {
      transform: none;
    }
    35% {
      transform: translateY(-0.16em);
    }
    65% {
      transform: translateY(0.03em);
    }
    100% {
      transform: none;
    }
  }

  .ct-text {
    margin: clamp(20px, 3vw, 32px) 0 0;
    max-width: 48ch;
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    align-items: end;
    margin-top: clamp(40px, 6vw, 80px);
  }

  .ct-label {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ct-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }

  .ct-mail a {
    font-weight: 600;
    font-size: clamp(1.15rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
    color: var(--color-text);
    padding-bottom: 4px;
    background: linear-gradient(var(--color-primary), var(--color-primary)) 0 100% / 100% 2px no-repeat;
    transition: background-size 0.6s var(--ease);
  }

  .ct-mail a:hover {
    color: var(--color-text);
    background-size: 0 2px;
    background-position: 100% 100%;
  }

  .ct-copy {
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .ct-copy:hover,
  .ct-copy.is-done {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .ct-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .ct-badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 156px;
    height: 156px;
    border-radius: 50%;
    color: var(--color-text);
    transition: transform 0.7s var(--ease);
  }

  .ct-badge:hover {
    color: var(--color-text);
    transform: scale(1.05);
  }

  .ct-badge__ring {
    position: absolute;
    inset: 0;
    animation: ct-spin 22s linear infinite;
  }

  .ct-badge:hover .ct-badge__ring {
    animation-duration: 8s;
  }

  .ct-badge__core {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 1.4rem;
    transition: transform 0.6s var(--ease);
  }

  .ct-badge:hover .ct-badge__core {
    transform: rotate(45deg);
  }

  @keyframes ct-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 759px) {
    .ct-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .ct-badge {
      width: 128px;
      height: 128px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-ch.is-hop,
    .ct-badge__ring {
      animation: none;
    }
  }
</style>
