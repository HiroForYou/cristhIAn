---
import { getImage } from 'astro:assets';
import concepts from '@/data/concepts.json';

const imageModules = import.meta.glob('/src/assets/concepts/*', { eager: true });

const items = await Promise.all(
  concepts.map(async concept => {
    const modulePath = `/src/assets/concepts/${concept.links.image}`;
    const mod = imageModules[modulePath];
    const thumb = await getImage({ src: mod.default, width: 400 });
    const full = await getImage({ src: mod.default, width: 1200 });
    return { ...concept, thumb: thumb.src, full: full.src };
  })
);
---

<div class="concepts-grid">
  {
    items.map(item => (
      <figure class="card concept-card">
        <button class="concept-card__trigger" type="button" data-full={item.full} data-title={item.title}>
          <img src={item.thumb} alt={item.title} loading="lazy" />
        </button>
        <figcaption>
          <span>{item.title}</span>
          <div class="concept-card__links">
            <a href={item.links.dribbble} target="_blank" rel="noopener noreferrer" aria-label="Dribbble shot">
              Dribbble
            </a>
            {item.links.demo && (
              <a href={item.links.demo} target="_blank" rel="noopener noreferrer" aria-label="Live demo">
                Demo
              </a>
            )}
          </div>
        </figcaption>
      </figure>
    ))
  }
</div>

<div class="concept-lightbox" id="concept-lightbox" hidden>
  <button class="concept-lightbox__close" type="button" aria-label="Close">✕</button>
  <img src="" alt="" />
</div>

<style>
  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .concept-card {
    padding: 0;
    overflow: hidden;
  }

  .concept-card__trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .concept-card__trigger img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    font-size: 0.9rem;
  }

  .concept-card__links {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .concept-lightbox {
    position: fixed;
    inset: 0;
    background: var(--color-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 32px;
  }

  .concept-lightbox[hidden] {
    display: none;
  }

  .concept-lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-card);
  }

  .concept-lightbox__close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
  }
</style>

<script>
  const lightbox = document.getElementById('concept-lightbox');
  const lightboxImg = lightbox?.querySelector('img');
  const closeBtn = lightbox?.querySelector('.concept-lightbox__close');

  document.querySelectorAll('.concept-card__trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.setAttribute('src', trigger.getAttribute('data-full') ?? '');
      lightboxImg.setAttribute('alt', trigger.getAttribute('data-title') ?? '');
      lightbox.hidden = false;
    });
  });

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
  };

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', event => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
