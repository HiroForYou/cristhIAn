---
import HeroCard from './HeroCard.astro';

const RESUME_URL =
  'https://drive.google.com/uc?export=download&id=1TeDAOJI9E3R_jIHo5t8MiVpzmnM9VQM3';
const GITHUB_URL = 'https://github.com/HiroForYou';
const LINKEDIN_URL = 'https://linkedin.com/in/cristhian-wiki/';
const PHRASES = ['Machine Learning Engineer', 'PyTorch lover ❤', 'Machine Learning Engineer'];
---

<section class="hero" id="about">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">
        <span class="hero__eyebrow-line" aria-hidden="true"></span>
        Hello, I'm
      </p>
      <h1>Cristhian Wiki</h1>
      <p class="hero__subtitle">
        <span id="hero-typewriter" data-phrases={JSON.stringify(PHRASES)}>{PHRASES[0]}</span><span
          id="hero-cursor"
          class="hero__cursor"
          aria-hidden="true">|</span
        >
      </p>
      <p class="hero__bio">
        Self-taught ML engineer from Peru, shipping deep learning systems from
        research to production — next up, grad school in deep learning and neuroscience.
      </p>

      <div class="hero__cta">
        <a class="btn btn-primary" href={RESUME_URL} target="_blank" rel="noopener noreferrer">
          Download Resume
        </a>
        <a class="btn btn-secondary hero__cta-secondary" href="/#projects">
          View Projects
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h8m0 0-3.5-3.5M12 8l-3.5 3.5"></path>
          </svg>
        </a>
      </div>

      <div class="hero__social">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.2.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            ></path>
          </svg>
        </a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <HeroCard />
  </div>
</section>

<script>
  const el = document.getElementById('hero-typewriter');
  const cursor = document.getElementById('hero-cursor');
  const phrases = JSON.parse(el?.getAttribute('data-phrases') ?? '[]');

  let phraseIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function tick() {
    if (!el) return;
    const current = phrases[phraseIndex];

    if (!deleting) {
      charIndex++;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === current.length) {
        deleting = true;
        setTimeout(tick, 3200);
        return;
      }
    } else {
      charIndex--;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
      }
    }

    setTimeout(tick, deleting ? 35 : 65);
  }

  // Until HeroCard's terminal sequence finishes, the first phrase just
  // sits there as static server-rendered text — no cursor, no blinking,
  // no typing — so the two animations don't run at once. Once it fires,
  // the cursor turns on and the cycle continues from "already typed"
  // straight into deleting, at the same pace tick() uses elsewhere.
  if (phrases.length) {
    window.addEventListener(
      'hero-terminal-done',
      () => {
        cursor?.classList.add('is-active');
        charIndex = phrases[0].length;
        deleting = true;
        setTimeout(tick, 3200);
      },
      { once: true }
    );
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(48px, 10vw, 96px);
  }

  .hero__glow {
    position: absolute;
    top: -10%;
    right: -8%;
    width: 620px;
    height: 620px;
    max-width: 60vw;
    max-height: 60vw;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-primary), transparent 62%);
    filter: blur(110px);
    opacity: 0.16;
    z-index: -2;
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        color-mix(in srgb, var(--color-text) 8%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, color-mix(in srgb, var(--color-text) 8%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 45%);
    mask-image: linear-gradient(to bottom, #000, transparent 45%);
    opacity: 0.6;
    z-index: -1;
    pointer-events: none;
  }

  :root[data-mode='light'] .hero__glow {
    opacity: 0.1;
  }

  :root[data-mode='light'] .hero__grid {
    /* Dark-on-light lines at the same low alpha as the dark theme read as
       nearly invisible in practice, so light mode gets stronger lines
       instead of just a lower layer opacity. */
    background-image: linear-gradient(
        color-mix(in srgb, var(--color-text) 18%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, color-mix(in srgb, var(--color-text) 18%, transparent) 1px, transparent 1px);
    opacity: 0.9;
  }

  .hero__inner {
    max-width: var(--content-width);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__text {
    max-width: 560px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    margin-bottom: 0.2em;
  }

  .hero__subtitle {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 1.1rem;
    min-height: 1.4em;
  }

  .hero__cursor {
    opacity: 0;
  }

  /* Stays hidden (and the phrase above stays static) until HeroCard's
     terminal sequence finishes and the JS below activates it. */
  .hero__cursor.is-active {
    opacity: 1;
    animation: hero-blink 1s step-end infinite;
  }

  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .hero__bio {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 54ch;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero__eyebrow-line {
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 28px 0;
  }

  .hero__cta-secondary svg {
    transition: transform 0.15s ease;
  }

  .hero__cta-secondary:hover svg {
    transform: translateX(3px);
  }

  .hero__social {
    display: flex;
    gap: 18px;
  }

  .hero__social a {
    color: var(--color-text-muted);
    display: inline-flex;
  }

  .hero__social a:hover {
    color: var(--color-primary-light);
  }
</style>
