---
import CaseStudies from './CaseStudies.astro';
import SmallProjects from './SmallProjects.astro';
import { getLang, useTranslations } from '@/i18n';

const t = useTranslations(getLang(Astro.url.pathname));
---

<section id="projects">
  <div class="container">
    <p class="eyebrow"><b>05</b>{t('projects.eyebrow')}</p>
    <h2 class="section-title" set:html={t('projects.title')} />

    <CaseStudies />
    <SmallProjects />
  </div>
</section>

<style>
  #projects {
    /* SmallProjects' own bottom padding plus the default section padding on
       both sides of the Projects→Contact boundary was stacking into a much
       bigger gap than any other section transition on the page. */
    padding-bottom: 40px;
  }
</style>
