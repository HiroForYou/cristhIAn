---
import CaseStudies from './CaseStudies.astro';
import SmallProjects from './SmallProjects.astro';
---

<section id="projects">
  <div class="container">
    <p class="eyebrow">Side projects</p>
    <h2>Projects</h2>

    <CaseStudies />
    <SmallProjects />
  </div>
</section>

<style>
  #projects {
    /* SmallProjects' own bottom padding plus the default section padding on
       both sides of the Projects→Contact boundary was stacking into a much
       bigger gap than any other section transition on the page. */
    padding-bottom: 40px;
  }
</style>
