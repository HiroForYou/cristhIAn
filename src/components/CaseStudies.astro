---
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const withProtocol = url => (url.startsWith('//') ? `https:${url}` : url);
---

<div class="case-studies">
  {
    studies.map(study => (
      <article class="card case-study">
        <div class="case-study__preview">
          <iframe
            src={withProtocol(study.data.iframe)}
            title={study.data.title}
            loading="lazy"
            frameborder="0"
            allow="accelerometer; autoplay; encrypted-media; gyroscope"
            allowfullscreen
          />
        </div>
        <div class="case-study__tech-icons" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="24" height="24" fill="var(--color-primary)">
            <path
              d="M15.9 2c-1.4 0-2.7.1-3.8.3-3.4.6-4 1.9-4 4.2v3.1h8v1H8.1c-2.3 0-4.3 1.4-5 4-.8 3-.8 4.9 0 7.9.6 2.3 2 4 4.3 4h2.8v-3.7c0-2.6 2.3-4.9 5-4.9h8c2.2 0 4-1.8 4-4V6.5c0-2.2-1.9-4-4-4.2-1.5-.2-3-.3-4.3-.3zm-4.5 2.5c.8 0 1.5.7 1.5 1.5S12.2 7.5 11.4 7.5 9.9 6.8 9.9 6s.7-1.5 1.5-1.5z"
            ></path>
            <path
              d="M16.1 30c1.4 0 2.7-.1 3.8-.3 3.4-.6 4-1.9 4-4.2v-3.1h-8v-1h11.9c2.3 0 4.3-1.4 5-4 .8-3 .8-4.9 0-7.9-.6-2.3-2-4-4.3-4h-2.8v3.7c0 2.6-2.3 4.9-5 4.9h-8c-2.2 0-4 1.8-4 4v6.4c0 2.2 1.9 4 4 4.2 1.5.2 3 .3 4.3.3zm4.5-2.5c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5z"
            ></path>
          </svg>
          <span class="case-study__js-badge">JS</span>
        </div>
        <div class="case-study__body">
          <h3>{study.data.title}</h3>
          <p>{study.data.excerpt}</p>
          <div class="case-study__tags">
            {study.data.info.tech.map(tech => (
              <span class="tag">{tech}</span>
            ))}
          </div>
          <div class="case-study__links">
            <a class="btn btn-primary" href={`/case-studies/${study.slug}/`}>
              Case Study
            </a>
            <a class="btn btn-secondary" href={withProtocol(study.data.demo)} target="_blank" rel="noopener noreferrer">
              Live Demo
            </a>
            <a class="btn btn-secondary" href={withProtocol(study.data.src)} target="_blank" rel="noopener noreferrer">
              Source
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .case-studies {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
  }

  .case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'body preview' 'body icons';
    gap: 12px 24px;
    align-items: center;
  }

  .case-study__preview {
    grid-area: preview;
  }

  .case-study__tech-icons {
    grid-area: icons;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .case-study__js-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.6rem;
    border-radius: 4px;
  }

  .case-study__body {
    grid-area: body;
  }

  .case-study__preview {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #000;
    padding-top: 56.25%;
  }

  .case-study__preview iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .case-study__body h3 {
    margin-bottom: 8px;
  }

  .case-study__body p {
    color: var(--color-text-muted);
  }

  .case-study__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 720px) {
    .case-study {
      grid-template-columns: 1fr;
      grid-template-areas: 'body' 'preview';
    }

    .case-study__tech-icons {
      display: none;
    }
  }
</style>
