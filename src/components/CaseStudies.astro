---
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);

const withProtocol = url => (url.startsWith('//') ? `https:${url}` : url);
---

<div class="case-studies">
  {
    studies.map(study => (
      <article class="card case-study">
        <div class="case-study__preview">
          <iframe
            src={withProtocol(study.data.iframe)}
            title={study.data.title}
            loading="lazy"
            frameborder="0"
            allow="accelerometer; autoplay; encrypted-media; gyroscope"
            allowfullscreen
          />
        </div>
        <div class="case-study__body">
          <h3>{study.data.title}</h3>
          <p>{study.data.excerpt}</p>
          <div class="case-study__tags">
            {study.data.info.tech.map(tech => (
              <span class="tag">{tech}</span>
            ))}
          </div>
          <div class="case-study__links">
            <a class="btn btn-primary" href={`/case-studies/${study.slug}/`}>
              Case Study
            </a>
            <a class="btn btn-secondary" href={withProtocol(study.data.demo)} target="_blank" rel="noopener noreferrer">
              Live Demo
            </a>
            <a class="btn btn-secondary" href={withProtocol(study.data.src)} target="_blank" rel="noopener noreferrer">
              Source
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .case-studies {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
  }

  .case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
  }

  .case-study__preview {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: #000;
    padding-top: 56.25%;
  }

  .case-study__preview iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .case-study__body h3 {
    margin-bottom: 8px;
  }

  .case-study__body p {
    color: var(--color-text-muted);
  }

  .case-study__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 720px) {
    .case-study {
      grid-template-columns: 1fr;
    }
  }
</style>
