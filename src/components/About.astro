---
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar-photo.jpg';
import SkewBg from './SkewBg.astro';
import { getLang, pick, useTranslations } from '@/i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

const quotes = [
  {
    text: {
      en: 'Any fool can write code that a computer understands. Good programmers write code that humans can understand.',
      es: 'Cualquier tonto puede escribir código que una computadora entienda. Los buenos programadores escriben código que los humanos pueden entender.',
    },
    author: 'Martin Fowler',
  },
  {
    text: {
      en: "Nothing interferes with my concentration. You could put on an orgy in my office and I wouldn't look up. Well, maybe once.",
      es: 'Nada interfiere con mi concentración. Podrías montar una orgía en mi oficina y no levantaría la vista. Bueno, quizá una vez.',
    },
    author: 'Isaac Asimov',
  },
  {
    text: {
      en: 'Somewhere, something incredible is waiting to be known.',
      es: 'En algún lugar, algo increíble está esperando ser descubierto.',
    },
    author: 'Carl Sagan',
  },
];
---

<section id="about" class="about-section">
  <SkewBg />
  <div class="container about">
    <p class="eyebrow"><b>01</b>{t('about.eyebrow')}</p>
    <h2 class="section-title" set:html={t('about.title')} />

    <div class="about__intro">
      <Image class="about__avatar" src={avatar} alt="Cristhian Wiki" width={230} height={230} />
      <p>
        {t('about.p1')}
        <br /><br />
        {t('about.p2')}
        <br /><br />
        {t('about.p3')}
      </p>
    </div>

    <div class="about__quotes">
      {
        quotes.map(quote => (
          <blockquote class="card">
            <p>&ldquo;{pick(quote.text, lang)}&rdquo;</p>
            <cite>— {quote.author}</cite>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
  }

  .about__intro {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .about__avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }

  .about__intro p {
    color: var(--color-text-muted);
    flex: 1;
    min-width: 260px;
  }

  .about__quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .about__quotes blockquote {
    margin: 0;
  }

  .about__quotes p {
    font-style: italic;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .about__quotes cite {
    color: var(--color-primary-light);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-style: normal;
  }

  @media (max-width: 700px) {
    .about__intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    /* auto-fit lands on 2 columns around this width, which strands an
       odd-numbered 3rd card alone in its own row with empty space next
       to it — force a single column instead of relying on auto-fit. */
    .about__quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
