---
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar-photo.jpg';
import SkewBg from './SkewBg.astro';

const quotes = [
  {
    text: 'Any fool can write code that a computer understands. Good programmers write code that humans can understand.',
    author: 'Martin Fowler',
  },
  {
    text: "Nothing interferes with my concentration. You could put on an orgy in my office and I wouldn't look up. Well, maybe once.",
    author: 'Isaac Asimov',
  },
  {
    text: 'Somewhere, something incredible is waiting to be known.',
    author: 'Carl Sagan',
  },
];
---

<section id="about" class="about-section">
  <SkewBg />
  <div class="container about">
    <p class="eyebrow">Who I am</p>
    <h2>About Me</h2>

    <div class="about__intro">
      <Image class="about__avatar" src={avatar} alt="Cristhian Wiki" width={230} height={230} />
      <p>
        Hi, I'm Cristhian Wiki, a passionate machine learning engineer and
        self-taught researcher from Peru. I am a PyTorch lover, very
        interested in the creation of novel neural network architectures
        (SOA), as well as their rapid implementation and accessibility
        (using MLOps tools).
        <br /><br />
        My goal as a human being is to be able to change the world and make
        it a better place (using deep learning and lots of creativity). I
        love a good challenge, and I'm planning to pursue a Master's or PhD
        next, focused on deep learning and neuroscience.
        <br /><br />
        Outside of work, you'll find me riding motorcycles, tinkering with
        cars, traveling whenever I can, and at the gym — but especially
        hanging out with my cats, who are pretty much my whole world.
      </p>
    </div>

    <div class="about__quotes">
      {
        quotes.map(quote => (
          <blockquote class="card">
            <p>&ldquo;{quote.text}&rdquo;</p>
            <cite>— {quote.author}</cite>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
  }

  .about__intro {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .about__avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }

  .about__intro p {
    color: var(--color-text-muted);
    flex: 1;
    min-width: 260px;
  }

  .about__quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .about__quotes blockquote {
    margin: 0;
  }

  .about__quotes p {
    font-style: italic;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .about__quotes cite {
    color: var(--color-primary-light);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-style: normal;
  }

  @media (max-width: 700px) {
    .about__intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    /* auto-fit lands on 2 columns around this width, which strands an
       odd-numbered 3rd card alone in its own row with empty space next
       to it — force a single column instead of relying on auto-fit. */
    .about__quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
