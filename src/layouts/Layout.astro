---
import '@/styles/global.css';
import ThemeVars from '@/components/ThemeVars.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { defaultPalette, defaultMode } from '@/config/palettes.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Cristhian Wiki — Machine Learning Engineer',
  description = 'Cristhian Wiki — Creative ML engineer who loves PyTorch and modern deep learning technologies.',
  image = '/images/social-banner.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={defaultPalette} data-mode={defaultMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://www.cristhianwiki.com/#person',
          name: 'Cristhian Wiki',
          alternateName: 'Cristhian Sanchez',
          jobTitle: 'Senior Machine Learning Engineer',
          url: 'https://www.cristhianwiki.com',
          image: new URL('/images/social-banner.jpg', Astro.site).toString(),
          worksFor: { '@type': 'Organization', name: 'Seidor Analytics' },
          sameAs: [
            'https://github.com/HiroForYou',
            'https://www.linkedin.com/in/cristhian-wiki/',
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.cristhianwiki.com/#website',
          name: 'Cristhian Wiki',
          url: 'https://www.cristhianwiki.com',
          author: { '@id': 'https://www.cristhianwiki.com/#person' },
        },
      ],
    })} />

    <ThemeVars />
    <script is:inline>
      const savedMode = localStorage.getItem('site-mode');
      if (savedMode) document.documentElement.dataset.mode = savedMode;
    </script>
    {import.meta.env.DEV && (
      <script is:inline>
        const saved = localStorage.getItem('dev-theme');
        if (saved) document.documentElement.dataset.theme = saved;
      </script>
    )}
  </head>
  <body>
    <slot />
    {import.meta.env.DEV && <ThemeToggle />}

    <script>
      // Smooths wheel/trackpad scrolling and same-page anchor jumps. Touch
      // keeps native scrolling, and reduced-motion users skip it entirely.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.15,
          easing: t => 1 - Math.pow(1 - t, 4),
          smoothWheel: true,
          syncTouch: false,
          anchors: { duration: 1.4 },
        });
        const loop = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }
    </script>

    <script>
      // Fades section content up the first time it scrolls into view.
      // Targets are picked by selector so components don't need extra
      // markup; carousel cards are skipped because they enter sideways.
      const REVEAL_TARGETS = [
        '.eyebrow',
        '.section-title',
        '.ct-h',
        '.ct-text',
        '.ct-grid',
        '.card:not(.carousel .card)',
        '.about__intro',
        '.st',
        '.small-projects__title',
      ]
        .map(selector => `main section:not(.hero) ${selector}`)
        .join(', ');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = [...document.querySelectorAll<HTMLElement>(REVEAL_TARGETS)];

        // Siblings revealed together cascade slightly instead of popping at once.
        targets.forEach(el => {
          const siblings = targets.filter(other => other.parentElement === el.parentElement);
          el.style.setProperty('--rv-i', String(Math.min(siblings.indexOf(el), 4)));
          el.classList.add('rv');
        });

        const observer = new IntersectionObserver(
          entries => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );

        // Anything already on screen is shown immediately (no flash on load).
        const viewport = window.innerHeight;
        targets.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < viewport * 0.94 && rect.bottom > 0) el.classList.add('is-in');
          else observer.observe(el);
        });

        document.documentElement.classList.add('rv-ready');
      }
    </script>
  </body>
</html>
